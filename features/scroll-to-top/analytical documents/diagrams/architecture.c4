// Каркас схемы взаимодействия сервисов для ADR.
// Копируется в features/<slug>/analytical documents/diagrams/architecture.c4 и заполняется сервисами фичи.
//
// Правила:
//   1. Стили задаются только здесь, в specification, по видам элементов.
//      В model и views стили не дублируются.
//   2. Иконки не используем. Смысл несут форма, цвет и легенда (notation).
//   3. У каждого элемента заполняется technology — без иконок это единственный
//      способ показать стек.
//   4. Проверка: npx likec4@latest validate .

specification {
  element actor {
    notation 'Пользователь или роль'
    style {
      shape person
      color indigo
    }
  }

  element webapp {
    notation 'Веб-интерфейс: витрина, админ-панель'
    style {
      shape browser
      color primary
    }
  }

  element mobileapp {
    notation 'Мобильное приложение'
    style {
      shape mobile
      color primary
    }
  }

  element service {
    notation 'Сервис, BFF или контейнер'
    style {
      shape component
      color primary
    }
  }

  element database {
    notation 'База данных'
    style {
      shape cylinder
      color green
    }
  }

  element broker {
    notation 'Брокер сообщений, очередь'
    style {
      shape queue
      color amber
    }
  }

  element filestore {
    notation 'Файловое хранилище'
    style {
      shape bucket
      color secondary
    }
  }

  element external {
    notation 'Внешняя система'
    style {
      shape rectangle
      color muted
    }
  }
}

model {
  buyer = actor 'Покупатель' { technology 'Человек' }
  storefront = webapp 'Витрина каталога' { technology 'Веб; стек требует проверки' }
  browser = external 'Браузер покупателя' { technology 'Browser APIs' }
  buyer -> storefront 'просматривает каталог и активирует кнопку'
  storefront -> browser 'события, настройка движения и управление прокруткой'
}

views {
  view index {
    title 'Прокрутка к началу каталога'
    include *
  }
}

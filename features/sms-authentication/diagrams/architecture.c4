// Каркас схемы взаимодействия сервисов для ADR.
// Копируется в features/<slug>/diagrams/architecture.c4 и заполняется сервисами фичи.
//
// Правила:
//   1. Стили задаются только здесь, в specification, по видам элементов.
//      В model и views стили не дублируются.
//   2. Иконки не используем. Смысл несут форма, цвет и легенда (notation).
//   3. У каждого элемента заполняется technology — без иконок это единственный
//      способ показать стек.
//   4. Проверка: npx likec4@latest validate .

specification {
  element actor {
    notation 'Пользователь или роль'
    style {
      shape person
      color indigo
    }
  }

  element webapp {
    notation 'Веб-интерфейс: витрина, админ-панель'
    style {
      shape browser
      color primary
    }
  }

  element mobileapp {
    notation 'Мобильное приложение'
    style {
      shape mobile
      color primary
    }
  }

  element service {
    notation 'Сервис, BFF или контейнер'
    style {
      shape component
      color primary
    }
  }

  element database {
    notation 'База данных'
    style {
      shape cylinder
      color green
    }
  }

  element broker {
    notation 'Брокер сообщений, очередь'
    style {
      shape queue
      color amber
    }
  }

  element filestore {
    notation 'Файловое хранилище'
    style {
      shape bucket
      color secondary
    }
  }

  element external {
    notation 'Внешняя система'
    style {
      shape rectangle
      color muted
    }
  }
}

model {
  customer = actor 'Клиент сайта' { technology 'Браузер' }
  site = webapp 'Витрина и личный кабинет' { technology 'Web / HTTPS' }
  auth = service 'Customer Auth (Passport)' { technology 'REST / HTTPS' }
  db = database 'Хранилище Customer Auth' { technology 'PostgreSQL — предложение ADR' }
  communication = service 'Communication' { technology 'REST / HTTPS' }
  dispatchDb = database 'Журнал отправок Communication' { technology 'PostgreSQL — предложение ADR' }
  gateway = external 'SMS-шлюз: поставщик не выбран' { technology 'HTTPS / webhook' }

  customer -> site 'Запрашивает код и входит'
  site -> auth 'HTTPS: код, вход, проверка сессии, выход'
  auth -> db 'SQL: транзакции и блокировки'
  auth -> communication 'HTTPS: одна попытка отправки'
  communication -> dispatchDb 'SQL: дедупликация и время передачи'
  communication -> gateway 'HTTPS: SMS'
  gateway -> customer 'SMS: шестизначный код'
  gateway -> communication 'HTTPS: статус доставки'
  communication -> auth 'HTTPS: проверенный статус'
}

views {
  view index {
    title 'SMS-авторизация: участники'
    include customer, site, auth, communication, gateway
  }
  view containers {
    title 'Контейнеры и хранилище'
    include *
  }
  dynamic view sendCode {
    title 'Отправка и подтверждение доставки'
    customer -> site 'Запрашивает код'
    site -> auth 'Передаёт запрос'
    auth -> db 'Фиксирует попытку и аннулирует старый код'
    auth -> communication 'Передаёт отправку'
    communication -> dispatchDb 'Фиксирует начало единственной попытки'
    communication -> gateway 'Один запрос SMS'
    gateway -> customer 'Доставляет код'
    gateway -> communication 'Подтверждает доставку'
    communication -> auth 'Передаёт проверенный статус'
    auth -> db 'Применяет подтверждение к действительному коду'
  }
  dynamic view signIn {
    title 'Проверка кода и вход'
    customer -> site 'Вводит код'
    site -> auth 'Передаёт номер и код'
    auth -> db 'Атомарно потребляет код, создаёт аккаунт и сессию'
    auth -> site 'Возвращает результат входа'
  }
}

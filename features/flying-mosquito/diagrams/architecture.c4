// Схема взаимодействия сервисов для фичи "Летающая муха на главной странице"
// Источник: 02-ADR.md, раздел 2 (задействованные сервисы)
// Каркас: .opencode/skills/adr-generator/templates/architecture.c4.tpl
// Открыть: расширение likec4.likec4-vscode или `npx likec4@latest start`
// Проверка: npx likec4@latest validate .
//
// Особенность фичи: бэкенд-сервисы платформы не участвуют.
// На схеме только витрина и клиентский декоративный компонент.

specification {
  element actor {
    notation 'Пользователь или роль'
    style {
      shape person
      color indigo
    }
  }

  element webapp {
    notation 'Веб-интерфейс: витрина, админ-панель'
    style {
      shape browser
      color primary
    }
  }

  element service {
    notation 'Сервис, BFF или контейнер'
    style {
      shape component
      color primary
    }
  }
}

model {
  visitor = actor 'Посетитель сайта'

  frontend = webapp 'Frontend' {
    technology 'Веб-витрина'
    description 'Публичная витрина сайта: отдаёт главную страницу и монтирует декоративный компонент'
  }

  mosquito = service 'Компонент «Муха»' {
    technology 'SVG + CSS-анимация'
    description 'Клиентский декоративный компонент: анимированный персонаж бренда, без API и хранилища'
  }

  visitor -> frontend 'открывает главную страницу'
  frontend -> mosquito 'монтирует только на главной'
}

views {
  view index {
    title 'Схема взаимодействия сервисов'
    include *
  }

  view featureScope {
    title 'Границы фичи: без бэкенда'
    include visitor, frontend, mosquito
  }
}
